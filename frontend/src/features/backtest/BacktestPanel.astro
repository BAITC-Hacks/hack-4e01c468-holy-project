---
import { Badge, Card, Empty, Icon, Table } from '@santi020k/lumen-astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { text } from '../../lib/preferences.mjs';

const t = (key: string) => text('ru', key);
---

<section id="backtest" class="section-block supporting-section" aria-labelledby="backtest-title">
  <SectionHeader
    kicker={t('historicalEvidence')}
    kickerKey="historicalEvidence"
    title={t('backtestTitle')}
    titleKey="backtestTitle"
    id="backtest-title"
    description={t('backtestDescription')}
    descriptionKey="backtestDescription"
  />
  <Card class="data-card evidence-card" as="section" aria-label={t('historicalEvidence')} data-i18n-aria="historicalEvidence">
    <div class="data-card-head">
      <div><span class="eyebrow" data-i18n="evaluationStatus">{t('evaluationStatus')}</span><p class="record-count" data-evaluation-period>{t('checkingEvaluation')}</p></div>
      <Badge variant="outline" data-backtest-badge>{t('awaitingEvaluation')}</Badge>
    </div>
    <div data-backtest-content>
      <Empty class="inline-empty" variant="compact" data-backtest-empty>
        <h3 data-i18n="evaluationNotLoaded">{t('evaluationNotLoaded')}</h3>
        <p data-i18n="historicalMetricsAppear">{t('historicalMetricsAppear')}</p>
      </Empty>
      <div class="metrics-table-scroll" data-backtest-table-wrap hidden>
        <Table class="metrics-table">
          <caption data-i18n="historicalEvaluationCaption">{t('historicalEvaluationCaption')}</caption>
          <thead><tr><th scope="col" data-i18n="model">{t('model')}</th><th scope="col" data-i18n="scope">{t('scope')}</th><th scope="col">MAE</th><th scope="col">RMSE</th><th scope="col" data-i18n="intervalCoverage">{t('intervalCoverage')}</th><th scope="col" data-i18n="rows">{t('rows')}</th></tr></thead>
          <tbody data-backtest-rows></tbody>
        </Table>
      </div>
    </div>
    <p class="evidence-footnote"><Icon name="info" size="sm" /> <span data-i18n="noFebruaryTruth">{t('noFebruaryTruth')}</span></p>
  </Card>
</section>
