---
import { Alert, Button, Card, Chart, Field, Icon, Input, Label, Select, Skeleton } from '@santi020k/lumen-astro';
import MetricCard from '../../components/MetricCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { text } from '../../lib/preferences.mjs';

const t = (key: Parameters<typeof text>[1]) => text('ru', key);
---

<section id="overview" class="overview-section" aria-labelledby="overview-title">
  <header class="hero-panel">
    <div class="hero-copy">
      <p class="section-kicker" data-i18n="overviewKicker">{t('overviewKicker')}</p>
      <h1 id="overview-title" data-i18n="overviewTitle">{t('overviewTitle')}</h1>
      <p class="hero-description" data-i18n="overviewDescription">{t('overviewDescription')}</p>
      <ul class="hero-capabilities" aria-label={t('heroCapabilities')} data-i18n-aria="heroCapabilities">
        <li><Icon name="wind" size="sm" /><span data-i18n="heroTwoTurbines">{t('heroTwoTurbines')}</span></li>
        <li><Icon name="clock-3" size="sm" /><span data-i18n="hero24And48">{t('hero24And48')}</span></li>
        <li><Icon name="chart-no-axes-combined" size="sm" /><span data-i18n="heroQuantiles">{t('heroQuantiles')}</span></li>
      </ul>
    </div>
    <div class="hero-art" aria-hidden="true">
      <img src="/images/wind-landscape.webp" alt="" fetchpriority="high" />
      <span class="hero-image-caption" data-i18n="heroImageCaption">{t('heroImageCaption')}</span>
    </div>
  </header>

  <div class="metric-strip" role="group" aria-label={t('selectedForecastFacts')} data-i18n-aria="selectedForecastFacts">
    <MetricCard name="horizon" label={t('forecastHorizon')} labelKey="forecastHorizon" value="—" />
    <MetricCard name="weather" label={t('weatherSource')} labelKey="weatherSource" value="—" />
    <MetricCard name="turbines" label={t('turbineCount')} labelKey="turbineCount" value="—" />
    <MetricCard name="status" label={t('currentRun')} labelKey="currentRun" value="—" />
  </div>

  <Alert class="run-alert" variant="warning" data-run-alert data-outcome="info" hidden aria-live="polite">
    <div class="run-alert-content">
      <Icon name="info" size="sm" />
      <p data-run-alert-text>{t('loadingLatestMessage')}</p>
      <button class="text-button" type="button" data-latest-retry hidden data-i18n="retryLatest">{t('retryLatest')}</button>
    </div>
  </Alert>

  <div class="forecast-grid">
    <Card class="chart-card" as="section" aria-labelledby="chart-heading">
      <div class="chart-context">
        <SectionHeader
          kicker={t('chartKicker')}
          kickerKey="chartKicker"
          title={t('chartTitle')}
          titleKey="chartTitle"
          id="chart-heading"
          description={t('chartDescription')}
          descriptionKey="chartDescription"
        />
        <div class="chart-context-detail">
          <StatusBadge label={t('awaitingRun')} outcome="unknown" />
          <span data-chart-window>—</span>
        </div>
      </div>
      <Chart class="forecast-chart" presentation="bare" aria-label={t('chartAria')} data-i18n-aria="chartAria">
        <div class="chart-host" data-forecast-chart>
          <Skeleton class="chart-skeleton" aria-label={t('loadingChart')} />
        </div>
      </Chart>
      <div class="chart-legend-note">
        <span><i class="legend-band" aria-hidden="true"></i><span data-i18n="quantileRange">{t('quantileRange')}</span></span>
        <span><i class="legend-median" aria-hidden="true"></i><span data-i18n="medianLine">{t('medianLine')}</span></span>
        <a class="quiet-link" href="#forecast"><span data-i18n="viewForecastRows">{t('viewForecastRows')}</span><Icon name="arrow-right" size="sm" /></a>
      </div>
      <div class="output-summary" aria-label={t('actualDataSummary')} data-i18n-aria="actualDataSummary">
        <article class="output-card">
          <span class="output-icon output-icon--green"><Icon name="wind" size="sm" /></span>
          <span class="output-label" data-i18n="turbineOne">{t('turbineOne')}</span>
          <strong data-summary-output="turbine_1">—</strong>
          <small data-i18n="latestMedian">{t('latestMedian')}</small>
        </article>
        <article class="output-card">
          <span class="output-icon output-icon--blue"><Icon name="wind" size="sm" /></span>
          <span class="output-label" data-i18n="turbineTwo">{t('turbineTwo')}</span>
          <strong data-summary-output="turbine_2">—</strong>
          <small data-i18n="latestMedian">{t('latestMedian')}</small>
        </article>
        <article class="output-card">
          <span class="output-icon output-icon--blue"><Icon name="database" size="sm" /></span>
          <span class="output-label" data-i18n="forecastRows">{t('forecastRows')}</span>
          <strong data-summary-row-count>—</strong>
          <small data-i18n="returnedByApi">{t('returnedByApi')}</small>
        </article>
        <article class="output-card">
          <span class="output-icon output-icon--green"><Icon name="chart-no-axes-combined" size="sm" /></span>
          <span class="output-label" data-i18n="predictionInterval">{t('predictionInterval')}</span>
          <strong>p10–p90</strong>
          <small data-i18n="returnedQuantiles">{t('returnedQuantiles')}</small>
        </article>
      </div>
    </Card>

    <div class="forecast-aside">
      <Card class="controls-card" as="section" aria-labelledby="new-forecast-title">
        <div class="control-heading">
          <span class="control-icon"><Icon name="sliders-horizontal" size="sm" /></span>
          <div><p class="section-kicker" data-i18n="chooseForecast">{t('chooseForecast')}</p><h2 id="new-forecast-title" data-i18n="chooseWindow">{t('chooseWindow')}</h2></div>
        </div>
        <p class="control-intro" data-i18n="originLocalHelp">{t('originLocalHelp')}</p>
        <form id="forecast-form" class="forecast-form">
          <Field class="forecast-field">
            <Label for="origin" data-i18n="forecastOrigin">{t('forecastOrigin')}</Label>
            <Input id="origin" name="origin" type="datetime-local" step="3600" required aria-describedby="origin-help" />
            <small id="origin-help"><span data-i18n="hourlyBoundary">{t('hourlyBoundary')}</span> · <span data-local-timezone>{t('localTimezone')}</span></small>
          </Field>
          <Field class="forecast-field">
            <Label id="horizon-label" for="horizon" data-i18n="horizonLabel">{t('horizonLabel')}</Label>
            <Select
              id="horizon"
              name="horizon"
              aria-labelledby="horizon-label"
              value="24"
              options={[
                { label: t('hours24'), value: '24' },
                { label: t('hours48'), value: '48' },
              ]}
              data-horizon-select
            />
          </Field>
          <div class="form-actions">
            <Button class="action-button" type="submit" name="intent" value="forecast">
              <Icon name="play" size="sm" /><span data-i18n="generateForecast">{t('generateForecast')}</span>
            </Button>
            <Button class="action-button" type="submit" name="intent" value="refresh" variant="outline">
              <Icon name="refresh-cw" size="sm" /><span data-i18n="freshForecast">{t('freshForecast')}</span>
            </Button>
          </div>
          <p class="form-status" data-job-feedback role="status" aria-live="polite"></p>
          <div class="job-recovery" data-job-recovery hidden>
            <Button class="action-button" type="button" variant="secondary" data-job-retry><span data-i18n="checkStatus">{t('checkStatus')}</span></Button>
          </div>
        </form>
      </Card>

      <Card class="run-context" as="section" aria-labelledby="selected-run-heading">
        <div class="context-heading">
          <span class="eyebrow" data-i18n="selectedRunHeading">{t('selectedRunHeading')}</span>
          <StatusBadge label={t('awaitingRun')} outcome="unknown" />
        </div>
        <h2 id="selected-run-heading" class="run-id" data-selected-run>{t('waitingForApi')}</h2>
        <div class="context-row"><span data-i18n="origin">{t('origin')}</span><strong data-run-origin>—</strong></div>
        <div class="context-row"><span data-i18n="reuse">{t('reuse')}</span><strong data-run-reuse>—</strong></div>
        <a class="download-link" data-csv-link hidden>
          <Icon name="download" size="sm" /><span data-i18n="downloadSelectedCsv">{t('downloadSelectedCsv')}</span><Icon name="arrow-up-right" size="sm" />
        </a>
      </Card>
    </div>
  </div>
</section>
