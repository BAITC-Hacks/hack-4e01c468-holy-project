---
import { Card, Icon, Table } from '@santi020k/lumen-astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { text } from '../../lib/preferences.mjs';

const t = (key: Parameters<typeof text>[1]) => text('ru', key);
---

<details class="forecast-records-disclosure">
  <summary data-i18n="viewForecastRows">{t('viewForecastRows')}</summary>
<section id="forecast" class="section-block supporting-section" aria-labelledby="forecast-rows-title">
  <SectionHeader
    kicker={t('forecastData')}
    kickerKey="forecastData"
    title={t('forecastRowsTitle')}
    titleKey="forecastRowsTitle"
    id="forecast-rows-title"
    description={t('forecastRowsDescription')}
    descriptionKey="forecastRowsDescription"
  />
  <Card class="data-card" as="section" aria-label={t('forecastRecordsAria')} data-i18n-aria="forecastRecordsAria">
    <div class="data-card-head">
      <div><span class="eyebrow" data-i18n="records">{t('records')}</span><p class="record-count" data-record-count>{t('loadingRows')}</p></div>
      <a class="download-link download-link--standalone" data-table-csv-link hidden>
        <Icon name="download" size="sm" /> <span data-i18n="downloadCsv">{t('downloadCsv')}</span>
      </a>
    </div>
    <div class="table-scroll forecast-table-scroll" tabindex="0" aria-label={t('scrollForecastTable')} data-i18n-aria="scrollForecastTable">
      <Table>
        <table class="forecast-table">
        <caption data-i18n="forecastTableCaption">{t('forecastTableCaption')}</caption>
        <thead>
          <tr><th scope="col" data-i18n="validTime">{t('validTime')}</th><th scope="col" data-i18n="turbine">{t('turbine')}</th><th scope="col" data-i18n="lead">{t('lead')}</th><th scope="col">P10</th><th scope="col">P50</th><th scope="col">P90</th></tr>
        </thead>
        <tbody data-forecast-rows>
          <tr><td colspan="6"><span class="table-loading" data-i18n="loadingForecastRows">{t('loadingForecastRows')}</span></td></tr>
        </tbody>
        </table>
      </Table>
    </div>
  </Card>
</section>
</details>
