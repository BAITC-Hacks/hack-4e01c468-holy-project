---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import Overview from '../features/forecast/Overview.astro';
import ForecastTable from '../features/forecast/ForecastTable.astro';
import BacktestPanel from '../features/backtest/BacktestPanel.astro';
import AgentTrace from '../features/agent-trace/AgentTrace.astro';
import DataQualityPanel from '../features/data-quality/DataQualityPanel.astro';
import { text } from '../lib/preferences.mjs';
---

<DashboardLayout
  title={text('ru', 'appTitle')}
  description={text('ru', 'appDescription')}
>
  <div class="dashboard-content">
    <Overview />
    <ForecastTable />
    <BacktestPanel />
    <div class="supporting-grid">
      <AgentTrace />
      <DataQualityPanel />
    </div>
    <footer class="page-footer">
      <span><strong data-i18n="footerBrand">WINDLINE</strong> <i aria-hidden="true">/</i> <span data-i18n="localForecastDesk">{text('ru', 'localForecastDesk')}</span></span>
      <span data-i18n="footerApiNote">{text('ru', 'footerApiNote')}</span>
    </footer>
  </div>
  <script>
    import { startDashboard } from '../lib/dashboard';

    startDashboard();
  </script>
</DashboardLayout>
